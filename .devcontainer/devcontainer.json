{
  // Generated by qadiff-dct
  "name": "Qadiff Dev (Claude Code-ready)",

  // ========================================
  // 初期化コマンド（コンテナ作成前にホスト側で実行）
  // ----------------------------------------
  // compose.override.yml を自動生成（ユーザー固有のホームディレクトリマウント）
  // ========================================
  "initializeCommand": "bash .devcontainer/init-compose-override.sh",

  // ========================================
  // Docker Compose連携 (常時有効)
  // ----------------------------------------
  // compose.yml: 共通設定（チーム共有）
  // compose.override.yml: ユーザー固有設定（.gitignore対象、initializeCommand で自動生成）
  // ========================================
  "dockerComposeFile": [
    "compose.yml",
    "compose.override.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // ========================================
  // features (追加機能)
  // ========================================
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
    ,"ghcr.io/devcontainers/features/node:1": {}
  },

  // ========================================
  // 環境変数
  // ========================================
  "containerEnv": {
    // Node.js のメモリ上限を拡張 (大規模プロジェクト対応)
    "NODE_OPTIONS": "--max-old-space-size=4096",
    // Claude Code 設定ディレクトリ
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Git status表示のパフォーマンス最適化
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",

    // Proxy passthrough (for corporate networks)
    // If your host uses a proxy to reach external services (e.g., Claude/OpenAI),
    // forwarding these env vars lets tools inside the container authenticate successfully.
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "http_proxy": "${localEnv:http_proxy}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "https_proxy": "${localEnv:https_proxy}",
    "NO_PROXY": "${localEnv:NO_PROXY}",
    "no_proxy": "${localEnv:no_proxy}",
    "ALL_PROXY": "${localEnv:ALL_PROXY}",
    "all_proxy": "${localEnv:all_proxy}"
  },

  // ========================================
  // ライフサイクルコマンド
  // ========================================
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  // ファイアウォール初期化 (各言語のパッケージレジストリを許可)
  "postStartCommand": "sudo -n bash .devcontainer/init-firewall.sh || true",
  // postStartCommand の完了を待ってから接続
  "waitFor": "postStartCommand",

  // ========================================
  // ユーザー設定
  // ========================================
  "remoteUser": "vscode",

  // ========================================
  // VS Code カスタマイズ
  // ========================================
  "customizations": {
    "vscode": {
      "extensions": [
  "anthropic.claude-code",
  "openai.chatgpt"
],
      "settings": {
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "git.autofetch": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "workbench.editor.enablePreview": false
}
    }
  }
}
